{
  "name": "family-travel-companion",
  "private": true,
  "version": "0.26.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run version:generate && tsc -b && vite build",
    "build:check": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "version:generate": "node scripts/generate-version.mjs",
    "version:patch": "node scripts/bump-version.mjs patch && npm run version:generate",
    "version:minor": "node scripts/bump-version.mjs minor && npm run version:generate",
    "version:major": "node scripts/bump-version.mjs major && npm run version:generate",
    "finish:patch": "node scripts/finish-change.mjs patch",
    "finish:minor": "node scripts/finish-change.mjs minor",
    "finish:major": "node scripts/finish-change.mjs major",
    "commit:checkpoint": "node scripts/commit-if-build-passes.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.16",
    "@supabase/supabase-js": "^2.45.4",
    "@vitejs/plugin-react": "^4.3.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "vite-plugin-pwa": "^0.21.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
